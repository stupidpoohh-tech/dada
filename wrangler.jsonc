{
  // 빌드 명령이 없는 정적 사이트다. 이 파일이 없으면 wrangler가 배포할 때마다
  // 설정을 스스로 만들며 자기 자신을 devDependency로 저장소에 설치하는데,
  // 그때 딸려오는 workerd 바이너리(144MB)가 에셋으로 업로드돼 25MB 제한에 걸렸다.
  // 올리지 않을 것은 .assetsignore에 적는다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dada-portfolio",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "assets": { "directory": "." }
}
